+func RecordProbeFailure(channelID, keyID int, modelName string) {
+	key := circuitKey(channelID, keyID, modelName)
+	value, ok := globalBreaker.Load(key)
+	if !ok {
+		return
+	}
+	entry := value.(*circuitEntry)
+	entry.mu.Lock()
