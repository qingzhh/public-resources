+	attempts := iter.Attempts()
+	if len(attempts) != 1 || attempts[0].PriceMultiplier == nil || *attempts[0].PriceMultiplier != 0.1 {
+		t.Fatalf("attempt multiplier = %+v, want 0.1", attempts)
+	}
+}
