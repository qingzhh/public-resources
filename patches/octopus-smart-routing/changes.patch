+func GroupReorder(req *model.GroupReorderRequest, ctx context.Context) error {
+	if req == nil || len(req.IDs) == 0 {
+		return fmt.Errorf("group reorder ids are required")
+	}
+	seen := make(map[int]struct{}, len(req.IDs))
+	for _, id := range req.IDs {
+		if id <= 0 {
+			return fmt.Errorf("invalid group id %d", id)
+		}
+		if _, ok := seen[id]; ok {
+			return fmt.Errorf("duplicate group id %d", id)
+		}
+		if _, ok := groupCache.Get(id); !ok {
+			return fmt.Errorf("group %d not found", id)
+		}
+		seen[id] = struct{}{}
+	}
+
+	tx := db.GetDB().WithContext(ctx).Begin()
+	for index, id := range req.IDs {
+		if err := tx.Model(&model.Group{}).Where("id = ?", id).Update("sort_order", index+1).Error; err != nil {
+			tx.Rollback()
+			return fmt.Errorf("failed to reorder group %d: %w", id, err)
+		}
+	}
+	if err := tx.Commit().Error; err != nil {
+		return fmt.Errorf("failed to commit group reorder: %w", err)
+	}
+	return groupRefreshCacheByIDs(req.IDs, ctx)
+}
