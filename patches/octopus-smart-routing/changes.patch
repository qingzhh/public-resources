+	globalBreaker.Range(func(rawKey, rawValue any) bool {
+		key, keyOK := rawKey.(string)
+		entry, valueOK := rawValue.(*circuitEntry)
+		if !keyOK || !valueOK {
+			return true
+		}
+		channelID, channelKeyID, modelName, ok := parseCircuitKey(key)
+		if !ok {
+			return true
+		}
+		entry.mu.Lock()
+		snapshot := CircuitSnapshot{
+			ChannelID:           channelID,
+			ChannelKeyID:        channelKeyID,
+			ModelName:           modelName,
+			State:               entry.State,
+			ConsecutiveFailures: entry.ConsecutiveFailures,
+			TripCount:           entry.TripCount,
+			LastFailureAt:       entry.LastFailureTime,
+		}
+		if entry.State == StateOpen {
+			remaining := GetCooldown(entry.TripCount) - now.Sub(entry.LastFailureTime)
+			if remaining > 0 {
+				snapshot.RemainingMS = remaining.Milliseconds()
+			}
+		}
+		entry.mu.Unlock()
+		result = append(result, snapshot)
+		return true
+	})
+	sort.Slice(result, func(i, j int) bool {
+		if result[i].ChannelID != result[j].ChannelID {
+			return result[i].ChannelID < result[j].ChannelID
+		}
+		if result[i].ModelName != result[j].ModelName {
+			return result[i].ModelName < result[j].ModelName
+		}
+		return result[i].ChannelKeyID < result[j].ChannelKeyID
+	})
+	return result
+}
+
+func CircuitStateName(state CircuitState) string {
+	switch state {
+	case StateOpen:
+		return "open"
+	case StateHalfOpen:
+		return "half_open"
+	default:
+		return "closed"
+	}
+}
