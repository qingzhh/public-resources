#!name=PT DNS - Domestic default / JP-HK exceptions
#!desc=Unlisted domains keep domestic encrypted DNS; listed exceptions use Cloudflare via the main-profile DNS policy. No GeoIP claim is made.
#!author=qingzhh
#!homepage=https://github.com/qingzhh/public-resources/tree/main/network/surge
#!category=qingzhh

# 2026-10-12 revision 2. Generated by scripts/build_pt_dns.py.
# Edit network/pt-dns/domains.json, NOT this generated file.
# The original 34 exceptions are preserved, not proven to be 34 poisoned names.
# No current A/AAAA geolocation or user-line connectivity measurement is available.
# Main profile prerequisites:
# encrypted-dns-follow-outbound-mode = true
# DOMAIN,cloudflare-dns.com,DNS-境外
# Create the policy in [Proxy Group], not inside a module.
# Native encrypted DNS may fall back to DIRECT when the proxy server uses a
# hostname. Choose a working IP-address-based proxy and check the traffic log.
# DNS route and website/Tracker route are independent. Keep the existing rules.
# No scripts run on the DNS hot path; no static target IPs or credentials.
# To restore a listed domain to domestic dual DoH without deleting its route,
# set that entry's optional resolver field to "default" and regenerate.

[Host]
agsv.top = server:https://cloudflare-dns.com/dns-query
